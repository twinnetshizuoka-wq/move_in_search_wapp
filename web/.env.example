# 本番サイト URL（Vercel のドメインまたは独自ドメイン）
NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app

# Stripe 決済用リンク（本環境の URL。未設定ならサイトに申し込みボタンは出ません）
NEXT_PUBLIC_STRIPE_PAYMENT_LINK=

# Stripe 契約確認用（Vercel の Sensitive 環境変数。rk_ の制限付きキーを推奨）
# 権限: Customers 読み取り / Subscriptions 読み取り
STRIPE_SECRET_KEY=

# Google AdSense（承認後に設定）
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=ca-pub-xxxxxxxxxxxxxxxx
NEXT_PUBLIC_ADSENSE_SLOT_HOME=0000000000
